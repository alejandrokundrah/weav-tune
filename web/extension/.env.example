# Extra origins (comma-separated) allowed to message the extension directly.
# Added to the manifest's externally_connectable.matches at build time so
# chrome.runtime is exposed to the deployed player.
# Example: WEAVTUNE_SITE_ORIGINS=https://app-kappa-two-37.vercel.app,https://example.com
WEAVTUNE_SITE_ORIGINS=

# Set to 1 for a Chrome Web Store upload (omits the pinned dev manifest `key`).
WEAVTUNE_STORE_BUILD=

# Discord presence. On for site zips by default; off for a Web Store upload
# unless set to 1.
DISCORD_PRESENCE=

# Weav-Tune Discord application id (17-20 digits), for cover images/buttons.
DISCORD_APP_ID=
