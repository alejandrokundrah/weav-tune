{
  "name": "weav-tune-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @weavtune/app dev",
    "dev:ext": "pnpm --filter @weavtune/extension dev",
    "dev:ext:firefox": "pnpm --filter @weavtune/extension dev:firefox",
    "build": "pnpm run build:site",
    "build:site": "pnpm --filter @weavtune/extension package && pnpm --filter @weavtune/app build",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/prepare-fixtures.mjs && pnpm -r test",
    "fixtures": "node scripts/capture-fixtures.mjs"
  }
}
